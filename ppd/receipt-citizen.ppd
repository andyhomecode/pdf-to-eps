*PPD-Adobe: "4.3"
*FormatVersion: "4.3"
*FileVersion: "1.0"
*LanguageVersion: English
*LanguageEncoding: ISOLatin1
*PCFileName: "citizen.ppd"
*Product: "(Citizen CD-S500A)"
*Manufacturer: "Citizen"
*ModelName: "Citizen CD-S500A"
*ShortNickName: "Citizen Receipt"
*NickName: "Citizen CD-S500A Receipt Printer (text)"
*PSVersion: "(3010.000) 0"
*LanguageLevel: "3"
*ColorDevice: True
*DefaultColorSpace: RGB
*FileSystem: False
*Throughput: "1"
*LandscapeOrientation: Plus90
*TTRasterizer: Type42

*OpenUI *PageSize/Page Size: PickOne
*DefaultPageSize: Letter
*PageSize Letter/US Letter: "<</PageSize[612 792]/ImagingBBox null>>setpagedevice"
*PageSize A4/A4: "<</PageSize[595.28 841.89]/ImagingBBox null>>setpagedevice"
*CloseUI: *PageSize

*OpenUI *PageRegion: PickOne
*DefaultPageRegion: Letter
*PageRegion Letter/US Letter: "<</PageSize[612 792]/ImagingBBox null>>setpagedevice"
*PageRegion A4/A4: "<</PageSize[595.28 841.89]/ImagingBBox null>>setpagedevice"
*CloseUI: *PageRegion

*DefaultImageableArea: Letter
*ImageableArea Letter/US Letter: "18.00 18.00 594.00 774.00"
*ImageableArea A4/A4: "18.00 18.00 577.28 823.89"

*DefaultPaperDimension: Letter
*PaperDimension Letter/US Letter: "612 792"
*PaperDimension A4/A4: "595.28 841.89"

*OpenUI *EscposProfile/Printer Model: PickOne
*DefaultEscposProfile: citizen-cd-s500a
*EscposProfile citizen-cd-s500a/Citizen CD-S500A: ""
*CloseUI: *EscposProfile

*OpenUI *EscposCols/Columns: PickOne
*DefaultEscposCols: 40
*EscposCols 33/33 columns (69.5mm paper): ""
*EscposCols 40/40 columns (76mm paper): ""
*EscposCols 42/42 columns: ""
*CloseUI: *EscposCols

*OpenUI *EscposCodepage/Character Set: PickOne
*DefaultEscposCodepage: cp437
*EscposCodepage cp437/CP437 (US): ""
*EscposCodepage cp858/CP858 (Western Europe): ""
*EscposCodepage latin-1/Latin-1: ""
*CloseUI: *EscposCodepage

*OpenUI *BoldInRed/Print Bold in Red: Boolean
*DefaultBoldInRed: True
*BoldInRed True/Yes: ""
*BoldInRed False/No: ""
*CloseUI: *BoldInRed

*OpenUI *PrintTitle/Print Job Title: Boolean
*DefaultPrintTitle: True
*PrintTitle True/Yes: ""
*PrintTitle False/No: ""
*CloseUI: *PrintTitle

*cupsFilter: "application/pdf 0 pdf2escpos.py"
*cupsFilter: "image/jpeg 0 pdf2escpos.py"
*cupsFilter: "image/png 0 pdf2escpos.py"
*cupsManualCopies: True
